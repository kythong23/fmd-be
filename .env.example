DATABASE_URL=postgres://postgres:postgres@localhost:5432/fmd
PORT=2304
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
REFRESH_EXPIRES_IN=30d
PUBLIC_BASE_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:2304
UPLOAD_DIR=uploads
CORS_ORIGIN=http://localhost:5173
ENABLE_DOCS=true

# Nhật ký API (/logs). ENABLE_LOG_UI=false để tắt trang UI; API vẫn chỉ manager mới gọi được.
# LOG_GET_BODY=true lưu cả response của GET — chỉ bật khi cần debug, log phình rất nhanh.
LOG_GET_BODY=false
LOG_RETENTION_DAYS=14
ENABLE_LOG_UI=true

# Chỉ dùng khi chạy bằng Docker (docker-compose.yml). Đặt mật khẩu dài, ngẫu nhiên.
DB_PASSWORD=change-me
